{
  "name": "2nd-brain-assignment",
  "version": "1.0.0",
  "description": "Access-Controlled Financial Knowledge Graph MCP Server",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prisma:generate": "prisma generate",
    "prisma:db:push": "prisma db push",
    "prisma:db:migrate": "prisma migrate dev",
    "data:generate": "tsx src/data/generator.ts",
    "data:ingest": "tsx src/ingestion/ingest.ts",
    "start": "tsx src/index.ts",
    "start:admin": "tsx src/index.ts --role=admin",
    "start:customer": "tsx src/index.ts --role=customer --caller=cust_001",
    "start:merchant": "tsx src/index.ts --role=merchant --caller=merch_001",
    "start:http": "tsx src/http.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "claude:config": "tsx scripts/write-claude-config.ts",
    "prepare": "husky"
  },
  "license": "ISC",
  "dependencies": {
    "@faker-js/faker": "^9.5.0",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@prisma/client": "^6.4.1",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.0.7"
  }
}
