datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AuditAction {
  READ
  LIST
}

enum AuditDecision {
  ALLOWED
  DENIED
}

model AuditLog {
  id           String        @id @default(cuid())
  callerId     String
  callerRole   String
  action       AuditAction
  resourceType String
  resourceId   String?
  decision     AuditDecision
  reason       String?
  toolName     String?
  requestId    String?
  // Additional field
  metadata     Json?

  // Optional: which fields were exposed/hidden
  fields Json?

  createdAt DateTime @default(now())

  @@index([callerId])
  @@index([callerRole])
  @@index([resourceType, resourceId])
  @@index([decision])
  @@index([createdAt])
  @@map("audit_logs")
}


model Document {
  id          String   @id
  name        String
  sourceType  String
  contentHash String @unique
  createdAt   DateTime @default(now())

  chunks  DocumentChunk[]
  entities Entity[]

  @@index([sourceType])
}

model DocumentChunk {
  id         String   @id
  documentId String
  content    String
  chunkIndex Int

  document Document @relation( fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Entity {
  id         String   @id
  type       String
  name       String
  properties Json?
  
  documentId String

  accessPolicy Json?

  document Document? @relation(fields: [documentId],references: [id],onDelete: SetNull)

  outgoingRelations GraphRelation[] @relation("SourceEntity")
  incomingRelations GraphRelation[] @relation("TargetEntity")

  createdAt DateTime @default(now())

  @@index([type])
  @@index([name])
  @@index([documentId])
}

model GraphRelation {
  id           String @id
  sourceId     String
  targetId     String
  relationType String

  properties Json?
  accessPolicy Json?

  source Entity @relation("SourceEntity", fields: [sourceId],references: [id],onDelete: Cascade )

  target Entity @relation("TargetEntity",fields: [targetId],references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([sourceId])
  @@index([targetId])
  @@index([relationType])
  @@unique([sourceId, targetId, relationType])
}